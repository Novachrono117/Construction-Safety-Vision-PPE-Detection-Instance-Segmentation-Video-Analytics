# Copy to `.env` and fill in locally. `.env` is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Project layout
# ---------------------------------------------------------------------------
# Optional. Absolute path to the repository root. Only needed when the code is
# executed from a location where the repository markers cannot be discovered by
# walking up the filesystem (e.g. some Google Colab layouts).
CSVISION_PROJECT_ROOT=

# ---------------------------------------------------------------------------
# Holdout protection
# ---------------------------------------------------------------------------
# The final holdout has been observed and is spent. Keep this variable UNSET.
# The dual gate remains in code for auditability; no second evaluation is allowed.
# Do not add this variable to an environment during delivery work.
# CSVISION_ALLOW_TEST_SPLIT is deliberately not assigned.

# ---------------------------------------------------------------------------
# Dataset source credentials (acquisition completed; historical source tooling)
# ---------------------------------------------------------------------------
# API key for the dataset host. Never hardcode this in code or notebooks.
ROBOFLOW_API_KEY=
