# Copy to `.env` and fill in locally. `.env` is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Project layout
# ---------------------------------------------------------------------------
# Optional. Absolute path to the repository root. Only needed when the code is
# executed from a location where the repository markers cannot be discovered by
# walking up the filesystem (e.g. some Google Colab layouts).
CSVISION_PROJECT_ROOT=

# ---------------------------------------------------------------------------
# Holdout protection
# ---------------------------------------------------------------------------
# The test split is a locked holdout. Reading it requires BOTH an explicit
# in-code opt-in AND this variable set to "1". Leave it empty during
# development; set it only for the single final test evaluation (phase 11).
CSVISION_ALLOW_TEST_SPLIT=

# ---------------------------------------------------------------------------
# Dataset source credentials (phase 3 - not used yet)
# ---------------------------------------------------------------------------
# API key for the dataset host. Never hardcode this in code or notebooks.
ROBOFLOW_API_KEY=
